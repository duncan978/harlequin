/* VARIABLES */
$border-color-nofocus: $panel;
$border-title-color-nofocus: $panel;
$border-color-focus: $primary;
$border-title-color-focus: $primary;

/* ALL WIDGETS */
DataCatalog,
EditorCollection,
FooterContainer > Input,
ResultsViewer,
Lazy {
    border: round $border-color-nofocus;
    border-title-color: $border-title-color-nofocus;
    background: $background;
}

LoadingIndicator {
    background: $background;
}

DataCatalog:focus-within,
EditorCollection:focus-within,
FooterContainer > Input:focus,
ResultsViewer:focus-within,
HistoryScreen TextArea:focus,
HistoryScreen OptionList:focus {
    border: round $border-color-focus;
    border-title-color: $border-title-color-focus;
}

CodeEditor:disabled,
Container:disabled,
DataCatalog:disabled,
EditorCollection:disabled,
ResultsViewer:disabled,
ResultsTable:disabled,
RunQueryBar:disabled,
Vertical:disabled {
    width: 0;
    height: 0;
    padding: 0 0;
    border: none;
}

Lazy {
    background: $background;
    color: $background;
    display: block;
    height: 1fr;
    width: 100%;
}

/* DATA CATALOG */
DataCatalog {
    height: 1fr;
    width: 1fr;
    layers: main overlay;
}

DataCatalog DatabaseTree,
DataCatalog FileTree,
DataCatalog S3Tree {
    background: $background;
    padding: 0 1;
    &:focus {
        background-tint: $background;
    }
}

DataCatalog * .harlequin-tree--type-label {
    color: $foreground-muted;
}

DataCatalog * .tree--cursor {
    text-style: bold;
    color: auto;
    background: $secondary-muted;
}

DataCatalog *:focus .tree--cursor {
    background: $secondary;
}

DataCatalog * .tree--guides {
    color: $primary;
}

DataCatalog * .tree--guides-hover {
    color: $primary;
}

DataCatalog * .tree--guides-selected {
    color: $secondary;
}

DataCatalog * .directory-tree--folder {
    text-style: bold;
}

DataCatalog * .directory-tree--hidden {
    text-style: dim italic;
}

DataCatalog ContextMenu {
    layer: overlay;
    display: none;
    padding: 1 1;
    border: none;
    color: $background;
    margin: 0 2;
    overflow: hidden auto;
    width: 1fr;
    max-width: 100%;
    max-height: 10;
    background: $panel ;
    &:focus{
        background: $secondary ;
        &>.option-list--option-hover {
            color: $background;
            background: $secondary;
            text-style: bold;
        }
        &>.option-list--option-highlighted {
            color: $secondary;
            background: $background;
            text-style: bold;
        }
    }
    &.open {
        display: block;
    }
}


/* RIGHT HAND CONTAINER */
#main_panel {
    width: 3fr;
}

EditorCollection {
    height: 1fr;
    width: 100%;
}
EditorCollection.premount {
    height: 0;
    border: none;
}

CodeEditor {
    height: 1fr;
    width: 100%;
}

CompletionList {
    background: $background-lighten-2 ;
}
CompletionList:focus {
    border: none;
}
CompletionList > .option-list--option-highlighted {
    color: $text;
    background: $secondary;
    text-style: bold;
}

/* RUN QUERY BAR */
RunQueryBar {
    height: 1;
    width: 100%;
    padding: 0 2 0 0;
    background: $background;
}

RunQueryBar #profile_label {
    width: auto;
    height: 1;
    padding: 0 1;
    margin: 0 1 0 0;
    color: $text-muted;
    background: $background;
}

RunQueryBar #profile_label.non-default {
    color: $background;
    background: $warning;
    text-style: bold;
}

RunQueryBar #profile_label.hidden {
    display: none;
}

RunQueryBar Horizontal#transaction_buttons {
    width: auto;
}

RunQueryBar Horizontal#run_buttons {
    width: 1fr;
    align-horizontal: right;
}

RunQueryBar Input {
    border: none;
    padding: 0;
    width: 7;
    background: $background;
}

RunQueryBar Input.-invalid {
    border: none;
    color: $error
}

Tooltip {
    border: round $border-color-focus;
    background: $background;
    padding: 0 1;
    max-height: 95vh;
    max-width: 40%;
}

RunQueryBar Button {
    border: none;
    height: 1;
}

RunQueryBar Button#run_query {
    background: $primary;
    color: $background;
    margin: 0 0 0 4;
    &:hover {
        background: $secondary;
        &:disabled {
            background: $primary;
        }
    }
    &:focus {
        text-style: reverse;
    }
    &.hidden {
        display: none;
    }
}

RunQueryBar Button#cancel_query {
    background: $error;
    color: $background;
    margin: 0 0 0 4;
    text-style: bold;
    &:hover {
        background: $secondary;
    }
    &:focus {
        text-style: reverse;
    }
    &.hidden {
        display: none;
    }
}

RunQueryBar Button#transaction_button,
RunQueryBar Button#commit_button,
RunQueryBar Button#rollback_button {
    background: $background;
    text-style: none;
    margin: 0 0 0 0;
}

RunQueryBar Button#commit_button,
RunQueryBar Button#rollback_button {
    width: auto;
    min-width: 3;
}

RunQueryBar Button#commit_button {
    color: $primary;
}

RunQueryBar Button#rollback_button {
    color: $error;
}

RunQueryBar Button#transaction_button.hidden,
RunQueryBar Button#commit_button.hidden,
RunQueryBar Button#rollback_button.hidden, {
    display: none;
}

RunQueryBar Button#transaction_button:hover,
RunQueryBar Button#commit_button:hover,
RunQueryBar Button#rollback_button:hover, {
    color: $secondary;
}

RunQueryBar Checkbox {
    border: none;
    padding: 0;
    background: $background;
    background-tint: $background;
}

RunQueryBar Checkbox:focus > .toggle--label {
    text-style: none;
    background: $background;
    background-tint: $background;
}

RunQueryBar Checkbox > .toggle--button {
    background: $panel
}

RunQueryBar Checkbox:hover {
    # background: $background-lighten-1;
    text-style: none;
}

RunQueryBar Checkbox:hover > .toggle--button {
    background: $secondary;
}

RunQueryBar Checkbox.-on > .toggle--button {
    color: $primary;
    background: $background-lighten-1
}

RunQueryBar Checkbox.-on:hover > .toggle--button {
    color: $primary;
    background: $secondary;
}

RunQueryBar Input:hover,
RunQueryBar Input:focus {
    background: $background-lighten-1;
}

RunQueryBar Input {
    background: $background;
}

RunQueryBar.non-responsive Checkbox, 
RunQueryBar.non-responsive Button, 
RunQueryBar.non-responsive Input {
    text-style: italic;
    background: $background;
}

/* RESULTS VIEWER */
ResultsViewer,
TabPane {
    height: 1fr;
    width: 1fr;
}

.hide-tabs Tabs {
    height: 0;
}

ResultsViewer .results-viewer--type-label {
    color: $foreground-muted;
}

TabPane {
    padding: 0;
}

ResultsViewer.non-responsive {
    border: round $panel-lighten-1;
}

ResultsTable > .datatable--header {
    text-style: bold;
    background: $background;
    color: $primary;
}

ResultsTable > .datatable--cursor {
    background: $secondary-muted;
    color: auto;
}

ResultsTable:focus > .datatable--cursor {
    background: $secondary;
}

ResultsTable > .datatable--header-hover {
    text-style: bold;
    background: $background;
    color: $primary;
}

ResultsTable > .datatable--hover {
    color: $text;
    background: $boost;
}

/* TEXT MODALS (CELL VIEW, ERROR) */
TextModal {
    align: center middle;
    padding: 0;
}

TextModal #modal_outer {
    margin: 5 10;
}

ErrorModal #modal_outer {
    border: round $error;
}

TextModal #modal_header {
    color: $text-muted;
}

TextModal #modal_inner {
    max-height: 100%;
    height: auto;
    padding: 1 1 1 2;
}

ClickableStatic {
    padding: 0 3 0 0;
}

ClickableStatic:hover {
    color: $primary;
}

/* HELP SCREEN */
HelpScreen {
    align: center middle;
    padding: 0;
}

/* Shared Components */

#modal_outer {
    border: round $border-color-focus;
    background: $background;
    margin: 2 4;
    padding: 1 2;
    max-width: 88;
}

#modal_header {
    dock: top;
    margin: 0 0 1 0;
    padding: 0 1;
}

#modal_inner {
    border: round $border-color-nofocus;
    padding: 0 0 0 0;
}

#modal_info {
    padding: 0 0 0 0;
}

#modal_footer {
    dock: bottom;
    color: $text-muted;
    margin: 1 0 0 0;
    padding: 0 1;
}

/* Export Screen */
ExportScreen {
    align: center middle;
    padding: 0;
}

#export_outer {
    border: round $border-color-focus;
    background: $background;
    margin: 2 4;
    padding: 1 2;
    max-width: 88;
}

#export_header {
    padding: 0 1;
}

#path_input {
    margin: 1 0 0 0;
}

#validation_label {
    color: $error;
    text-style: italic;
    margin: 0 0 0 3;
}

ExportScreen #validation_label {
    height: 1;
}

ExportScreen .option_row {
    height: 3;
    margin: 1 1 0 0;
}

ExportScreen Horizontal Label {
    height: 1;
    text-align: right;
    width: 20;
}

.select_label, .switch_label, .input_label {
    margin: 1 2 0 1;
}

ExportScreen Horizontal Select {
    width: 41; /* off by one!? */
    padding: 0;
    margin: 0;
}

ExportScreen Horizontal Select > SelectCurrent {
    width: 40;
    background: transparent;
    border: round $border-color-nofocus;
    margin: 0 0 0 0;
}

ExportScreen Horizontal Select:focus-within > SelectCurrent {
    border: round $border-color-focus;
}

ExportScreen Horizontal Select > SelectOverlay {
    width: 40;
    border: round $border-color-focus;
    background: transparent;
}

ExportScreen Input {
    border: round $border-color-nofocus;
    background: transparent;
}

ExportScreen Input:focus {
    border: round $border-color-focus;
}

ExportScreen Horizontal Input {
    width: 40;
}

ExportScreen Switch {
    border: none;
    padding: 1 2;
    &:hover {
        border: tall $border-color-focus;
        padding: 0 1;
    }
    &:focus {
        border: tall $border-color-focus;
        padding: 0 1;
    }
}

ExportScreen Switch.-on > .switch--slider {
    color: $primary;
}

CopyOptionsMenu {
    height: auto;
}

#export_button_row {
    height: auto;
    align: center bottom;
    margin: 1 0 0 0;
}

ExportScreen Button {
    background: $primary;
    height: 3;
    margin: 0 6;
    border: none;
}

ExportScreen Button:focus {
    text-style: reverse;
}

#cancel{
    background: $panel;
}

ExportScreen Button:hover,
#cancel:hover {
    background: $secondary;
}

/* HISTORY SCREEN */

HistoryScreen TextArea {
    border: round $border-color-nofocus;
    width: 50%;
    height: 100%;
}

HistoryScreen OptionList {
    background: $background;
    background-tint: $background;
    border: round $border-color-nofocus;
    width: 50%;
    height: 100%;
    padding: 0;
}

HistoryScreen OptionList > .option-list--option-highlighted {
    background: $secondary;
    color: auto;
    text-style: none;
}


HistoryScreen OptionList > .option-list--option-hover {
    color: $text;
    background: $boost;
}

HistoryScreen OptionList > .option-list--option-hover-highlighted {
    background: $secondary;
    color: auto;
    text-style: none;
}

HistoryScreen .history-screen--error-label {
    color: $error;
    text-style: bold italic;
}

/* DEBUG INFO SCREEN */

DebugInfoScreen {
    align: center middle;
    padding: 0;
}

/* ConfirmModal */

ConfirmModal {
    align: center middle;
    padding: 0;
}

ConfirmModal Vertical#outer {
    border: round $border-color-focus;
    background: $background;
    margin: 2 0;
    padding: 1 1;
    height: auto;
    max-height: 30;
    width: auto;
    max-width: 88;
}

ConfirmModal Label {
    width: 100%;
    text-align: center;

}

ConfirmModal Horizontal#button_row {
    height: auto;
    width: auto;
    align: center bottom;
    margin: 2 0 1 0;
}

ConfirmModal Horizontal#button_row Button {
    background: $primary;
    height: 3;
    margin: 0 4;
    padding: 0 1;
    min-width: 16;
    border: none;
    &:hover {
        background: $secondary;
    }
    &:focus {
        text-style: reverse;
    }
}

ConfirmModal Horizontal#button_row Button#no{
    background: $error;
    &:hover {
        background: $secondary;
    }
}

/* COLUMN LIST (the `c` modal and the Data Catalog's Columns tab) */
ColumnList {
    height: 1fr;
    width: 1fr;
    padding: 0;
}

ColumnList .column_filter,
SectionList .column_filter {
    border: none;
    height: 1;
    padding: 0 1;
    margin: 0 0 1 0;
    background: $background-lighten-1;
}

ColumnList .column_filter:focus,
SectionList .column_filter:focus {
    background: $background-lighten-1;
}

ColumnList .column_list,
SectionList .column_list {
    background: $background;
    background-tint: $background;
    border: round $border-color-nofocus;
    border-title-color: $border-title-color-nofocus;
    height: 1fr;
    width: 100%;
    padding: 0;
}

ColumnList:focus-within .column_list,
SectionList:focus-within .column_list {
    border: round $border-color-focus;
    border-title-color: $border-title-color-focus;
}

ColumnList .column_list > .option-list--option-highlighted,
SectionList .column_list > .option-list--option-highlighted {
    background: $secondary;
    color: auto;
    text-style: none;
}

ColumnList .column_list > .option-list--option-hover,
SectionList .column_list > .option-list--option-hover {
    color: $text;
    background: $boost;
}

ColumnList .column_list_footer,
SectionList .column_list_footer {
    dock: bottom;
    color: $text-muted;
    margin: 1 0 0 0;
    padding: 0 1;
}

/* the Columns tab lives inside the catalog's own border, so it does not
   need a second one of its own around the filter row */
DataCatalog ColumnList {
    padding: 0 1;
}

/* COLUMNS MODAL, and the SECTION NAVIGATOR, which is the same shape */
ColumnsModal,
SectionsModal {
    align: center middle;
    padding: 0;
}

ColumnsModal #modal_outer,
SectionsModal #modal_outer {
    margin: 2 4;
    width: 70%;
    max-width: 88;
    height: 80%;
    max-height: 40;
}

/* RenameModal */

RenameModal {
    align: center middle;
    padding: 0;
}

RenameModal Vertical#outer {
    border: round $border-color-focus;
    background: $background;
    padding: 1 2;
    height: auto;
    width: 60;
    max-width: 88;
}

RenameModal Label#prompt_label {
    width: 100%;
    padding: 0 0 1 0;
}

RenameModal Label#hint_label {
    width: 100%;
    padding: 1 0 0 0;
    color: $text-muted;
}

RenameModal Input {
    width: 100%;
}

/* NARROW MODE (fork). Under catalog_min_width the Data Catalog is a drawer over
   the main panel instead of a column beside it: its own layer (dock alone would
   reserve space), as tall as the editor so the Run Query Bar stays clear (the
   app sets that height), solid background so the editor doesn't bleed through.
   Kept together, at the end, to stay clear of upstream's blocks when
   rebasing. */
#panes {
    layers: main overlay;
}

DataCatalog.overlay {
    layer: overlay;
    dock: right;
    width: 32;
    /* the app sets an inline height so the drawer stops above the Run Query
       Bar; this is the fallback for before the editor has been laid out */
    height: 100%;
    background: $background;
}

DataCatalog.overlay.dock-left {
    dock: left;
}

DataCatalog.overlay:disabled {
    width: 0;
    height: 0;
    padding: 0 0;
    border: none;
}

/* the mouse's way to the drawer; only shown in narrow mode */
RunQueryBar Button#catalog_button {
    background: $background;
    color: $text-muted;
    text-style: none;
    width: auto;
    min-width: 11;
    margin: 0 1 0 0;
    &:hover {
        color: $secondary;
    }
    &.hidden {
        display: none;
    }
    /* `catalog_side = "right"`: the button sits on the drawer's own edge, and
       the 1fr run buttons right-align against it in the room that is left */
    &.dock-right {
        dock: right;
        margin: 0 0 0 1;
    }
}

/* compact labels: "Run" and "Tx: Auto" sized to fit */
RunQueryBar.narrow Button#run_query {
    min-width: 5;
}

RunQueryBar.narrow Button#transaction_button {
    min-width: 10;
}

/* A section tab (ctrl+backslash) is part of another tab and has to look like it.
   Dimmed and italic, never a second hue: the palette must stay readable for someone
   who cannot rely on telling colours apart. The label carries `> <parent number>`. */
Tab.section-tab {
    color: $text-muted;
    text-style: italic;
}

Tab.section-tab.-active {
    color: $text;
    text-style: italic;
}
